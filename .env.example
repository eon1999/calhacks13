# Convex (set by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Voice agent (server-only; read by Next.js route handlers in app/api/voice/*).
# Locally: put real values in .env.local. On Vercel: add the same names under
# Project Settings → Environment Variables, then redeploy. Never commit them.
# NEXT_PUBLIC_CONVEX_URL must point at the *cloud* deployment on Vercel, not
# the local one (run `npx convex deploy` first).
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Optional: Cartesia voice id for the wearable's voice (defaults in lib/voice/config.ts)
CARTESIA_VOICE_ID=

# Phone agent (lib/phone/*). Create the agent in the Cartesia dashboard (paste
# WELCOME_MESSAGE and INSTRUCTIONS from lib/phone/script.ts) and get a number.
# - Urgent alerts call the emergency contacts from Convex (convex/phone.ts), so
#   set all three as Convex env vars: `npx convex env set CARTESIA_API_KEY ...`
#   (and the two below). Without them, calls are a dry run logged in phoneCalls.
# - The manual test route POST /api/phone/call reads them from .env.local.
CARTESIA_PHONE_AGENT_ID=
# The number's ID in Cartesia (not the phone number itself).
CARTESIA_FROM_NUMBER_ID=

# Debug/tester endpoints (/api/debug/*) are always on in dev. Set to 1 to
# enable them in a production build for testers.
CADENCE_DEBUG=

# Text alerts (convex/notify.ts) run inside Convex, so these are Convex env
# vars, NOT Next.js ones. Set them with `npx convex env set NAME value` (and
# again with `--prod` for the cloud deployment). Without them, texts are a dry
# run: logged on /hub as "skipped" but not sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=        (a Twilio number like +14155550123, or a Messaging Service SID MG...)

# Clerk sign-in (optional). Leave empty to run on per-browser demo identities.
# Clerk Dashboard → API keys. The secret key is server-only; never expose it.
# Convex already trusts https://perfect-ewe-2767.clerk.accounts.dev (convex/auth.config.ts).
# Publishable key is public (derived from the Frontend API URL perfect-ewe-2767.clerk.accounts.dev).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cGVyZmVjdC1ld2UtMjc2Ny5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=

# Not used yet:
# MOSS_API_KEY=
