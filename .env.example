# Convex (set by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Voice agent (server-only; read by Next.js route handlers in app/api/voice/*).
# Locally: put real values in .env.local. On Vercel: add the same names under
# Project Settings → Environment Variables, then redeploy. Never commit them.
# NEXT_PUBLIC_CONVEX_URL must point at the *cloud* deployment on Vercel, not
# the local one (run `npx convex deploy` first).
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Optional: Cartesia voice id for the wearable's voice (defaults in lib/voice/config.ts)
CARTESIA_VOICE_ID=

# Phone agent (lib/phone/*, POST /api/phone/call). Uses CARTESIA_API_KEY above.
# TODO: create the agent in the Cartesia dashboard (paste lib/phone/script.ts)
# and buy or import a number, then fill these in.
CARTESIA_PHONE_AGENT_ID=
# The number's ID in Cartesia (not the phone number itself).
CARTESIA_FROM_NUMBER_ID=

# Debug/tester endpoints (/api/debug/*) are always on in dev. Set to 1 to
# enable them in a production build for testers.
CADENCE_DEBUG=

# Not used yet:
# MOSS_API_KEY=
